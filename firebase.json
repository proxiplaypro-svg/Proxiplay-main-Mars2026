{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "functions": {
    "source": "firebase/functions"
  },
  "emulators": {
    "singleProjectMode": true,
    "hub": {
      "port": 4400
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    }
  },
  "hosting": {
    "public": "hosting",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/j/**",
        "destination": "/j/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://www.proxiplay.fr/",
        "type": 301
      },
      {
        "source": "/legal.html",
        "destination": "https://www.proxiplay.fr/legal.html",
        "type": 301
      },
      {
        "source": "/suppression-compte/**",
        "destination": "https://www.proxiplay.fr/suppression-compte.html",
        "type": 301
      }
    ]
  }
}
