{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions",
  "dependencies": {
    "@langchain/anthropic": "^0.1.1",
    "@langchain/core": "^0.3.19",
    "@langchain/google-genai": "^0.0.8",
    "@langchain/langgraph": "^0.2.23",
    "@langchain/openai": "^0.3.14",
    "@mux/mux-node": "^7.3.3",
    "@onesignal/node-onesignal": "^2.0.1-beta2",
    "axios": "1.12.0",
    "braintree": "^3.6.0",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.4.1",
    "nodemailer": "^6.10.1",
    "qs": "^6.7.0",
    "razorpay": "^2.8.4",
    "stripe": "^8.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^20.17.57",
    "eslint": "^6.8.0",
    "eslint-plugin-promise": "^4.2.1",
    "firebase-functions-test": "^3.5.0",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "lint": "./node_modules/.bin/eslint --max-warnings=0 .",
    "serve": "firebase -P proxi-play-odzp2e emulators:start --only functions",
    "shell": "firebase -P proxi-play-odzp2e functions:shell",
    "start": "npm run shell",
    "logs": "firebase -P proxi-play-odzp2e functions:log",
    "compile": "tsc --project tsconfig.json",
    "test:instant-winners": "node --test test/instant_winners_core.test.js",
    "simulate:instant-winners": "node scripts/simulate_instant_winners.js",
    "simulate:due-instant-selection": "node scripts/simulate_due_instant_selection.js",
    "audit:instant-winners": "node scripts/audit_instant_winners.js --project=proxi-play-odzp2e",
    "audit:account-routing": "node scripts/audit_account_routing.js --project=proxi-play-odzp2e",
    "audit:account-routing:all": "node scripts/audit_account_routing.js --project=proxi-play-odzp2e --all",
    "audit:account-routing:report": "node scripts/audit_account_routing.js --project=proxi-play-odzp2e --json-out=reports/account-routing-audit.json --csv-out=reports/account-routing-audit.csv",
    "audit:account-routing:report:all": "node scripts/audit_account_routing.js --project=proxi-play-odzp2e --all --json-out=reports/account-routing-audit-all.json --csv-out=reports/account-routing-audit-all.csv",
    "backfill:remaining-part:dry": "node scripts/backfill_remaining_part.js --project=proxi-play-odzp2e --dry-run",
    "backfill:remaining-part": "node scripts/backfill_remaining_part.js --project=proxi-play-odzp2e --apply --confirm",
    "backfill:player-status:dry": "node scripts/backfill_player_status_cached.js --project proxi-play-odzp2e --dry-run",
    "backfill:player-status": "node scripts/backfill_player_status_cached.js --project proxi-play-odzp2e --apply --confirm",
    "backfill:winner-fields:dry": "node scripts/backfill_winner_denormalized_fields.js --project=proxi-play-odzp2e",
    "backfill:winner-fields": "node scripts/backfill_winner_denormalized_fields.js --project=proxi-play-odzp2e --apply --confirm",
    "test:firestore-rules": "firebase emulators:exec --only firestore \"node --test test/firestore_rules_users.test.js\"",
    "test:prize-winner-contact": "firebase emulators:exec --only firestore \"node --test test/get_prize_winner_contact_for_merchant.test.js\"",
    "test:already-played-no-parts": "firebase emulators:exec --only firestore \"node --test test/participate_already_played_no_parts.test.js\""
  },
  "engines": {
    "node": "20"
  },
  "private": true
}
