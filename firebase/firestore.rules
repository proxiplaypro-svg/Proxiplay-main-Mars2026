rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.admin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.user_role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userRole == 'admin'
        );
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCurrentUserRef(userRef) {
      return isSignedIn() &&
        userRef == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isOwnerRef(userRef) {
      return isSignedIn() &&
        userRef == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isMerchantOwnerOfEnseigne(enseigneRef) {
      return isSignedIn() &&
        enseigneRef != null &&
        get(enseigneRef).data.owner ==
          /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isPrizeClaimValidationUpdate() {
      return resource.data.claimed != true &&
        request.resource.data.claimed == true &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['claimed']);
    }

    function isAllowedSelfUserCreate(userId) {
      return isSelf(userId) &&
        request.resource.data.uid == request.auth.uid &&
        (
          !('user_role' in request.resource.data) ||
          request.resource.data.user_role in ['joueur', 'commercant']
        ) &&
        !('account_status' in request.resource.data) &&
        !('remaining_part' in request.resource.data) &&
        !('allGamesAccessUntil' in request.resource.data) &&
        !('games_played_count' in request.resource.data) &&
        !('player_status_cached' in request.resource.data) &&
        !('last_inactive_relaunch_at' in request.resource.data) &&
        !('last_real_activity_at' in request.resource.data);
    }

    function isSafeSelfUserUpdate() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly([
          'email',
          'phone_number',
          'first_name',
          'last_name',
          'pseudo',
          'display_name',
          'photo_url',
          'city',
          'city_insee_code',
          'birthday',
          'professional_category'
        ]);
    }

    match /users/{document} {
      allow create: if isAdmin() || isAllowedSelfUserCreate(document);
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow update: if isAdmin() || (isSelf(document) && isSafeSelfUserUpdate());
      allow delete: if isSelf(document) || isAdmin();
    }

    match /users/{parent}/favorite_games/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /enseignes/{document} {
      allow create: if isAdmin() ||
        (
          isSignedIn() &&
          ('owner' in request.resource.data) &&
          isOwnerRef(request.resource.data.owner)
        );
      allow read: if true;
      allow update: if isAdmin() || isOwnerRef(resource.data.owner);
      allow delete: if isAdmin() || isOwnerRef(resource.data.owner);
    }

    match /games/{document} {
      allow create: if request.auth != null &&
        (request.resource.data.create_by == /databases/$(database)/documents/users/$(request.auth.uid) || isAdmin());
      allow read: if true;
      allow update: if isAdmin() ||
        resource.data.create_by == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if isAdmin() ||
        resource.data.create_by == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /users/{parent}/favorite_enseignes/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /users/{parent}/my_lots/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /games/{parent}/participants/{document} {
      // Les participations sont créées exclusivement via la Cloud Function
      // participateInGameTransaction afin d'empêcher plusieurs parties
      // sur un même jeu le même jour.
      allow create: if false;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/participants/{document} {
      allow read: if true;
    }


    match /users/{parent}/my_enseignes/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /enseignes/{parent}/enseigne_game/{document} {
      allow create: if get(/databases/$(database)/documents/enseignes/$(parent)).data.owner == /databases/$(database)/documents/users/$(request.auth.uid);
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/enseignes/$(parent)).data.owner == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if get(/databases/$(database)/documents/enseignes/$(parent)).data.owner == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /{path=**}/enseigne_game/{document} {
      allow read: if true;
    }


    match /users/{parent}/identity_documents/{document} {
      allow create: if isSelf(parent) || isAdmin();
      allow read: if isSelf(parent) || isAdmin();
      allow update: if isSelf(parent) || isAdmin();
      allow delete: if isSelf(parent) || isAdmin();
    }

    match /{path=**}/identity_documents/{document} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }


    match /enseignes/{parent}/horaires/{document} {
      allow create: if isAdmin() || isMerchantOwnerOfEnseigne(
        /databases/$(database)/documents/enseignes/$(parent)
      );
      allow read: if true;
      allow update, delete: if isAdmin() || isMerchantOwnerOfEnseigne(
        /databases/$(database)/documents/enseignes/$(parent)
      );
    }

    match /{path=**}/horaires/{document} {
      allow read: if true;
    }


    match /enseignes/{parent}/images/{document} {
      allow create: if isAdmin() || isMerchantOwnerOfEnseigne(
        /databases/$(database)/documents/enseignes/$(parent)
      );
      allow read: if true;
      allow update, delete: if isAdmin() || isMerchantOwnerOfEnseigne(
        /databases/$(database)/documents/enseignes/$(parent)
      );
    }

    match /{path=**}/images/{document} {
      allow read: if true;
    }


    match /games/{parent}/winners/{document} {
      allow create, update, delete: if false;
      allow read: if true;
    }

    match /{path=**}/winners/{document} {
      allow read: if true;
      allow create, update, delete: if false;
    }


    match /prizes/{document} {
      allow create, delete: if false;
      allow update: if isAdmin() || (
        isPrizeClaimValidationUpdate() &&
        (
          isOwnerRef(resource.data.owner_id) ||
          isMerchantOwnerOfEnseigne(resource.data.enseigne_id)
        )
      );
      allow read: if true;
    }

    match /users/{parent}/notifications/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /users/{parent}/fcm_tokens/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent || isAdmin();
      allow write: if request.auth.uid == parent || isAdmin();
      allow delete: if request.auth.uid == parent || isAdmin();
    }

    match /games/{parent}/participants_details/{document} {
      allow create, update, delete: if false;
      allow read: if true;
    }

    match /{path=**}/participants_details/{document} {
      allow read: if true;
      allow create, update, delete: if false;
    }


    match /games/{parent}/instant_winners/{document} {
      allow create, update, delete: if isAdmin() ||
        get(/databases/$(database)/documents/games/$(parent)).data.create_by ==
          /databases/$(database)/documents/users/$(request.auth.uid);
      allow read: if true;
    }

    match /{path=**}/instant_winners/{document} {
      allow read: if true;
      allow create, update, delete: if false;
    }


    match /accountDeletionRequests/{document} {
      allow create: if isAdmin() || (
        isSignedIn() &&
        isCurrentUserRef(request.resource.data.merchant_id) &&
        request.resource.data.keys().hasOnly(['merchant_id', 'requested_at'])
      );
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          isCurrentUserRef(resource.data.merchant_id) ||
          isSelf(document)
        )
      );
      allow update, delete: if isAdmin();
    }

    match /ff_push_notifications/{document} {
      allow create, read, update, delete: if isAdmin();
    }

    match /app_config/share_promo {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_config/mobile_versioning {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAdmin() ||
        (isSignedIn() && (
          resource.data.inviterUid == request.auth.uid ||
          resource.data.inviteeUid == request.auth.uid
        ));
      allow create, update, delete: if false;
    }

    match /users/{uid}/private/share_state {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /reward_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /animations/{animationId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /entries/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /admin_stats/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stats/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
